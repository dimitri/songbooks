# Copy to .env (same directory as docker-compose.yml) and fill in before
# `docker compose up -d`. .env itself must never be committed.

# Postgres credentials for the `db` service. Pick a real password — this
# instance holds the real song library, and the db container isn't
# published on any host port, but the password still matters (pg_dump/
# pg_restore access, any future host-port exposure, etc).
POSTGRES_USER=songbooks
POSTGRES_PASSWORD=changeme-pick-a-real-password
POSTGRES_DB=songbooks

# Absolute path on the HOST to a copy of songbooks/v2 (the Typst pipeline:
# lib/, render.typ, render-book.typ, fonts/). Needed for PDF export (both
# the Typst "chart" export and, indirectly, nothing LilyPond-specific — but
# keep it in sync with the real v2/ tree's templates/fonts). The app
# container writes scratch files under this path at request time, so it
# must be writable by the container's user.
#
# Typical first deploy: `rsync -a --delete /Users/dim/dev/songbooks/v2/
# dev-runner:~/dev/www/songbooks/v2/` from the dev Mac, then point this at
# that copy.
V2_HOST_PATH=/home/dim/dev/www/songbooks/v2
