# Copy to .env (same directory as docker-compose.yml) and fill in before
# `docker compose up -d`. .env itself must never be committed.

# Postgres credentials for the `db` service. Pick a real password — this
# instance holds the real song library, and the db container isn't
# published on any host port, but the password still matters (pg_dump/
# pg_restore access, any future host-port exposure, etc).
POSTGRES_USER=songbooks
POSTGRES_PASSWORD=changeme-pick-a-real-password
POSTGRES_DB=songbooks

# Which deployment this is (deploy/target.sh): production
#   COMPOSE_PROJECT_NAME=songbooks-prod, SONGBOOKS_PORT=8103,
#   COMPOSE_PROFILES=stems,live, SONGBOOKS_WEBAUTHN_RP_ID=app.songbooks.studio
# or staging (the defaults below).
COMPOSE_PROJECT_NAME=songbooks
SONGBOOKS_PORT=8102
# COMPOSE_PROFILES=stems

# Passkey (WebAuthn) Relying Party ID — the exact public hostname passkeys
# registered on this deployment are bound to. Must be set before any
# passkey is registered here; see deploy/README.md's "Passkeys" section.
SONGBOOKS_WEBAUTHN_RP_ID=songbooks.tapoueh.org

# Live lessons (docs/live-lessons.md): galene/setup.sh writes the key
# Galène checks the join tokens with; Galène's address defaults to
# production's. Without a key, online lessons say they aren't set up.
# SONGBOOKS_GALENE_KEY=
# SONGBOOKS_GALENE_URL=https://live.songbooks.studio
