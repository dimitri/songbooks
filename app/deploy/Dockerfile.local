# syntax=docker/dockerfile:1
# Local development image for docker-compose.local.yml: same Go build as
# deploy/Dockerfile, native to the host's architecture (Apple Silicon
# included), with only the runtime tools the app actually calls into —
# ffmpeg (audio transcoding: GP backing tracks, uploads) and yt-dlp
# (YouTube reference audio). The production image's LilyPond tarball is
# x86_64-only and its export path is unused, so it's left out here.
FROM golang:1.26-bookworm AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/songbooks ./cmd/songbooks
# sbdemo: the admin page's demo data buttons run it (docs/demo-data.md).
RUN CGO_ENABLED=0 go build -o /out/sbdemo ./cmd/sbdemo

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl python3 ffmpeg \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /usr/local/bin/yt-dlp \
        https://github.com/yt-dlp/yt-dlp/releases/download/2026.10.26/yt-dlp \
    && chmod a+rx /usr/local/bin/yt-dlp
# GeneralUser GS, as deploy/Dockerfile fetches it (the pins are there;
# deploy/fetch-soundfont.sh reads them from it, docs/soundfont.md).
COPY deploy/Dockerfile deploy/fetch-soundfont.sh /tmp/soundfont/
RUN sh /tmp/soundfont/fetch-soundfont.sh /usr/local/share/songbooks && rm -rf /tmp/soundfont
COPY --from=builder /out/songbooks /usr/local/bin/songbooks
COPY --from=builder /out/sbdemo /usr/local/bin/sbdemo
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/songbooks"]
