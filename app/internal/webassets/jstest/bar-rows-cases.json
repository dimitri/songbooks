{
  "about": "The Song view's rows (static/js/bar-rows.js, by jstest/bar-rows.test.mjs) and the PDF's (pdfnative/bar_rows.go, by TestBarRowsCases) from one table: rows are the bar counts of a section's rows as the server groups them (a pickup counted in the first; a section without \"bars:\" is pooled), want each row's bar count and how many bars wide its regular bars are drawn. fit/fitFirst: the most regular bars a row / the first row can hold (left out: no limit, as on paper).",
  "cases": [
    { "name": "1 bar", "rows": [1], "opts": { "perRow": 4 }, "want": [{ "bars": 1, "cap": 4 }] },
    { "name": "4 bars", "rows": [4], "opts": { "perRow": 4 }, "want": [{ "bars": 4, "cap": 4 }] },
    { "name": "5 bars: one row of 5", "rows": [5], "opts": { "perRow": 4 }, "want": [{ "bars": 5, "cap": 5 }] },
    { "name": "6 bars: 4 + 2", "rows": [6], "opts": { "perRow": 4 }, "want": [{ "bars": 4, "cap": 4 }, { "bars": 2, "cap": 4 }] },
    { "name": "9 bars: 4 + 5", "rows": [8, 1], "opts": { "perRow": 4 }, "want": [{ "bars": 4, "cap": 4 }, { "bars": 5, "cap": 5 }] },
    { "name": "10 bars: 4 + 4 + 2", "rows": [8, 2], "opts": { "perRow": 4 }, "want": [{ "bars": 4, "cap": 4 }, { "bars": 4, "cap": 4 }, { "bars": 2, "cap": 4 }] },
    { "name": "13 bars: 4 + 4 + 5", "rows": [8, 5], "opts": { "perRow": 4 }, "want": [{ "bars": 4, "cap": 4 }, { "bars": 4, "cap": 4 }, { "bars": 5, "cap": 5 }] },
    { "name": "14 bars: 4 + 4 + 4 + 2", "rows": [8, 6], "opts": { "perRow": 4 }, "want": [{ "bars": 4, "cap": 4 }, { "bars": 4, "cap": 4 }, { "bars": 4, "cap": 4 }, { "bars": 2, "cap": 4 }] },
    { "name": "pickup + 5 bars: one row", "rows": [6], "opts": { "perRow": 4, "pickup": true }, "want": [{ "bars": 6, "cap": 5 }] },
    { "name": "pickup + 4 bars", "rows": [5], "opts": { "perRow": 4, "pickup": true }, "want": [{ "bars": 5, "cap": 4 }] },
    { "name": "pickup + 8 bars: the pickup rides on the first row", "rows": [9], "opts": { "perRow": 4, "pickup": true }, "want": [{ "bars": 5, "cap": 4 }, { "bars": 4, "cap": 4 }] },
    { "name": "pickup + 10 bars", "rows": [9, 2], "opts": { "perRow": 4, "pickup": true }, "want": [{ "bars": 5, "cap": 4 }, { "bars": 4, "cap": 4 }, { "bars": 2, "cap": 4 }] },
    { "name": "pickup + 16 bars (the server's 9 + 8)", "rows": [9, 8], "opts": { "perRow": 4, "pickup": true }, "want": [{ "bars": 5, "cap": 4 }, { "bars": 4, "cap": 4 }, { "bars": 4, "cap": 4 }, { "bars": 4, "cap": 4 }] },
    { "name": "only the pickup", "rows": [1], "opts": { "perRow": 4, "pickup": true }, "want": [{ "bars": 1, "cap": 1 }] },
    { "name": "no room for 5: a short row of 1", "rows": [9], "opts": { "perRow": 4, "fit": 4 }, "want": [{ "bars": 4, "cap": 4 }, { "bars": 4, "cap": 4 }, { "bars": 1, "cap": 4 }] },
    { "name": "the first row holds less", "rows": [5], "opts": { "perRow": 4, "fitFirst": 4, "fit": 8 }, "want": [{ "bars": 4, "cap": 4 }, { "bars": 1, "cap": 4 }] },
    { "name": "3 to a row, 7 bars", "rows": [7], "opts": { "perRow": 3 }, "want": [{ "bars": 3, "cap": 3 }, { "bars": 4, "cap": 4 }] },
    { "name": "bars: 3 over 7 bars", "rows": [3, 3, 1], "opts": { "perRow": 4, "explicit": true }, "want": [{ "bars": 3, "cap": 3 }, { "bars": 3, "cap": 3 }, { "bars": 1, "cap": 3 }] },
    { "name": "bars: 8 is two phrases a row, on screen and paper", "rows": [8, 8], "opts": { "perRow": 4, "explicit": true }, "want": [{ "bars": 4, "cap": 4 }, { "bars": 4, "cap": 4 }, { "bars": 4, "cap": 4 }, { "bars": 4, "cap": 4 }] },
    { "name": "bars: 5, room for 5", "rows": [5, 5], "opts": { "perRow": 4, "explicit": true }, "want": [{ "bars": 5, "cap": 5 }, { "bars": 5, "cap": 5 }] },
    { "name": "bars: 5 with a pickup, room for 5", "rows": [5, 5], "opts": { "perRow": 4, "explicit": true, "pickup": true }, "want": [{ "bars": 5, "cap": 4 }, { "bars": 5, "cap": 5 }] },
    { "name": "bars: 5 with a pickup, no room: 3 + 2, never a lone bar", "rows": [5, 5], "opts": { "perRow": 4, "explicit": true, "pickup": true, "fitFirst": 3, "fit": 4 }, "want": [{ "bars": 3, "cap": 4 }, { "bars": 2, "cap": 4 }, { "bars": 3, "cap": 4 }, { "bars": 2, "cap": 4 }] },
    { "name": "bars: 6 splits 4 + 2", "rows": [6], "opts": { "perRow": 4, "explicit": true }, "want": [{ "bars": 4, "cap": 4 }, { "bars": 2, "cap": 4 }] },
    { "name": "bars: 4 with a count-in, the pickup one of the 4", "rows": [4, 4, 4, 4, 1], "opts": { "perRow": 4, "explicit": true, "pickup": true }, "want": [{ "bars": 4, "cap": 3 }, { "bars": 4, "cap": 4 }, { "bars": 4, "cap": 4 }, { "bars": 4, "cap": 4 }, { "bars": 1, "cap": 4 }] },
    { "name": "nothing", "rows": [], "opts": { "perRow": 4 }, "want": [] }
  ]
}
